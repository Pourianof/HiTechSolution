# .gitignore for ASP.NET Core / .NET projects

# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# vscode
.vscode*/

# Rider
.idea/
*.sln.iml

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Database
*.mdf
*.ldf

# Publish results
publish/

# Secrets
secrets.json
appsettings.*.local.json

# Others
*.db
*.sqlite

# Test results
TestResults/

wwwroot/

# npm packages
node_modules/
admin.conf
*.pem
