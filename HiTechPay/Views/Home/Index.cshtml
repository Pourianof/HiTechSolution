@page
@model dynamic
@{
    Layout = "_Layout";
}


<!-- Dark gradient overlay -->
<div class="absolute inset-0 bg-linear-to-b from-black/70 to-black/90"></div>

<!-- Floating Glow Elements -->
<div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute top-20 left-10 w-72 h-72 bg-cyan-400/20 blur-3xl rounded-full animate-pulse"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-indigo-500/20 blur-3xl rounded-full animate-pulse"></div>
</div>

<!-- Center Content -->
<div class="relative z-10 flex h-full items-center justify-center px-6">
    <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-2xl p-10 max-w-xl text-center shadow-2xl">
        <div class="flex flex-col items-center gap-4">
            <div class="w-16 h-16 rounded-xl bg-linear-to-br from-cyan-400 to-indigo-500 flex items-center justify-center text-xl font-bold shadow-lg">
                HT
            </div>

            <h1 class="text-3xl font-bold mt-2">Welcome to <span class="inline-block bg-linear-to-r from-indigo-500 to-cyan-400 bg-clip-text text-transparent">
            HiTechPay
            </span>
            </h1>
            <p class="text-gray-300 max-w-md">
                A simple payment simulator for <span class="inline-block p-1 rounded font-semibold bg-red-400 text-black">HiTechStore</span> App
            </p>

            <a asp-page="/App/Index"
                class="mt-6 inline-block bg-linear-to-r from-indigo-500 to-cyan-400 text-black font-semibold px-6 py-3 rounded-xl shadow-md hover:opacity-90 transition">
                Go to store
            </a>
        </div>
    </div>
</div>